    final h=await fixture(); identify(h);
    h._reworkStaged.clear(); h._reworkMetadataFixed.addAll(['1.jpg','2.jpg']);
    await h._onSubmitReworkPressed();
    final batch=await queued(db);
    final (conn,sink)=await realPg();
    try {
      await conn.execute("ALTER TABLE rework_logs ADD CONSTRAINT acceptance_fail CHECK(rework_status <> 'CLOSED')");
      await expectLater(sink.apply(batch),throwsA(isA<ServerException>()));
      expect((await conn.execute('SELECT qc_status FROM capture_folders ORDER BY id')).map((r)=>r[0]),['REWORK','REWORK']);
      expect((await conn.execute("SELECT count(*) FROM rework_logs WHERE rework_status='CLOSED'")).single[0],0);
      expect(await queued(db),hasLength(4));
      await conn.execute('ALTER TABLE rework_logs DROP CONSTRAINT acceptance_fail');
      await sink.apply(batch);
      expect((await conn.execute("SELECT count(*) FROM rework_logs WHERE rework_status='CLOSED'")).single[0],2);
      expect((await conn.execute('SELECT qc_status FROM capture_folders ORDER BY id')).map((r)=>r[0]),['PENDING','PENDING']);
      print('LIVE_PG fault/retry: server constraint rolled back complete batch; exact durable batch retried successfully');
    } finally { await conn.close(); }

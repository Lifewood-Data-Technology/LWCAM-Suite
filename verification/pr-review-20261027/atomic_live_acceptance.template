class _SubmitHarness {
  final BoxSessionController _boxSession;
  final AuthController auth;
  final List<ReworkItem> _reworkItems;
  final Map<String, File> targets;
  _SubmitHarness(this._boxSession, this.auth, this._reworkItems, this.targets);
  final List<String> writes = [];
  bool shareUnavailable = false;
  late BuildContext context;
  bool get mounted => true;
  void setState(VoidCallback fn) => fn();
  bool _reworkSubmitting = false;
  bool _isWaitingForRecapture = false;
  String statusMsg = '';
  final Set<String> _reworkUndoing = {};
  final Map<int, CaptureFolder> _reworkEdited = {};
  Map<String, File> get _reworkStaged => _boxSession.reworkStaged;
  Set<String> get _reworkMetadataFixed => _boxSession.reworkMetadataFixed;
  Map<int, List<ReworkItem>> get _reworkByFolderSeq => groupReworkByFolderSeq(_reworkItems);
  AuditLogService? get _auditOrNull => null;
  static const _kInputShareDown = 'offline';
  Future<ReworkInput> _resolveReworkInput(ReworkItem item) async => shareUnavailable ? const ReworkInput(FsProbe.unreachable,null) : ReworkInput(FsProbe.found, targets[item.imageName]);
  Future<void> _productionOverwriteReworkFileAtomically({
    required File source,
    required File target,
  }) async {
    final temp = File(
      p.join(target.parent.path, '.${p.basename(target.path)}.rework_tmp'),
    );
    try {
      // A crash mid-submit can leave one behind; copy() would fail on it.
      if (await temp.exists()) await temp.delete();
      // Drop any decoded copy of the image we are about to replace. Flutter
      // holds bytes rather than a handle, so this is defensive rather than
      // known-necessary — but it is free, and it guarantees the tile re-reads
      // the new pixels instead of showing the rejected frame from cache.
      try {
        await FileImage(target).evict();
      } catch (_) {}
      await source.copy(temp.path);
      if (await temp.length() <= 0) {
        throw StateError('the replacement image copied as an empty file');
      }
      Object? lastError;
      for (var attempt = 0; attempt < kReworkRenameAttempts; attempt++) {
        try {
          await temp.rename(target.path);
          return;
        } catch (e) {
          lastError = e;
          await Future<void>.delayed(kReworkRenameRetryDelay);
        }
      }
      throw StateError(
        'could not replace ${p.basename(target.path)} after '
        '$kReworkRenameAttempts attempts. ${_describeWriteBlock(temp, target)} '
        'If the destination is BLOCKED while the temp file is writable, this is '
        "almost certainly antivirus folder protection (Avast's Ransomware "
        'Shield, Defender\'s Controlled Folder Access): those allow NEW files '
        'but refuse to let an untrusted program modify EXISTING ones, and the '
        'capture roots sit under Desktop, which they protect by default. Allow '
        'LWCAM in the shield, or move the processing roots out of Desktop / '
        'Documents (LWCam Admin -> Station Setup). '
        'Last error: $lastError',
      );
    } catch (e) {
      try {
        if (await temp.exists()) await temp.delete();
      } catch (_) {}
      rethrow;
    }
  }

  /// Says WHICH of the two paths is unwritable when a replace fails, so the
  /// next occurrence identifies the blocker instead of guessing at it.
  ///
  /// A rename-replace needs delete access on [temp] AND on [target]; "Access is
  /// denied" alone does not say which side is held. Probing both narrows it in
  /// one line: the destination points at whatever is reading the image (an
  /// external viewer, a scanner); the temp points at whatever just touched the
  /// file we wrote (antivirus on close is the classic); neither points at
  /// directory permissions or a delete-pending state.
  ///
  /// Ruled out by measurement on 2026-07-30, so do not re-chase them: the
  /// directory itself (probe rename of a 16MB file succeeded), Dart's rename
  /// API (same probe through dart:io succeeded), the read-only attribute (all
  /// Archive), and LWIP (journal untouched since 16:38, nothing logged, and it
  /// only opens inputs for a folder it is actively reprocessing).
  /// Opens [f] for WRITE without truncating a byte, purely to see whether that
  /// is currently allowed. Append mode takes a write handle and writes nothing.
  String _probeWritable(File f) {
    try {
      if (!f.existsSync()) return 'missing';
      f.openSync(mode: FileMode.append).closeSync();
      return 'writable';
    } catch (e) {
      return 'BLOCKED ($e)';
    }
  }

  String _describeWriteBlock(File temp, File target) =>
      'Blocker probe — destination: ${_probeWritable(target)}, '
      'temp: ${_probeWritable(temp)}.';

  Future<void> _overwriteReworkFileAtomically({required File source, required File target}) async {
    writes.add(p.basename(target.path));
    await _productionOverwriteReworkFileAtomically(source:source,target:target);
  }
  Future<void> _refreshSavedBoxThumbnail(int box, String name, File file) async {}
  Map<String, Object?> _changedReworkColumns(CaptureFolder folder, List<ReworkItem> items) => {};
// PRODUCTION_SUBMIT
// PRODUCTION_BUTTON
// PRODUCTION_UNDO
}


Future<(Connection,PgSyncSink)> realPg() async {
  final home=Platform.environment['USERPROFILE']!;
  final config=await NodeConfigService(getConfigPath:()=>p.join(home,'LWCAM_DBs','lwcam_node_config.json')).load();
  final conn=await openPgConnection(host:config.pgHost!,port:config.pgPort,
    database:config.pgDatabase!,user:config.pgUser!,password:config.pgPassword!,useSsl:config.pgUseSsl);
  try {
    // Actual schema column types, isolated session-local tables. Public data is
    // neither changed nor copied; no roles, users or projects are provisioned.
    for(final table in ['projects','users','capture_boxes','capture_folders','capture_images','rework_logs']) {
      await conn.execute('CREATE TEMP TABLE $table AS SELECT * FROM public.$table WITH NO DATA');
    }
    await conn.execute('CREATE TEMP SEQUENCE acceptance_rework_id');
    await conn.execute("ALTER TABLE rework_logs ALTER COLUMN id SET DEFAULT nextval('acceptance_rework_id')");
    await conn.execute("INSERT INTO projects(id,project_key,project_id) VALUES(1,'pk','PRJ')");
    await conn.execute("INSERT INTO users(id,user_id) VALUES(1,'acceptance_operator')");
    await conn.execute("INSERT INTO capture_boxes(box_id,project_id,box_name) VALUES(1,1,'BOX')");
    for(var n=1;n<=2;n++) {
      await conn.execute("INSERT INTO capture_folders(id,box_id,folder_seq,qc_status,is_deskewed,is_cropped) VALUES($n,1,$n,'REWORK',FALSE,FALSE)");
      await conn.execute("INSERT INTO capture_images(id,folder_id,image_name) VALUES($n,$n,'$n.jpg')");
      await conn.execute("INSERT INTO rework_logs(image_id,folder_id,assigned_uid,rework_status,created_at) VALUES($n,$n,1,'OPEN',clock_timestamp()-interval '1 minute')");
    }
    final sink=PgSyncSink(host:config.pgHost!,port:config.pgPort,database:config.pgDatabase!,
      user:config.pgUser!,password:config.pgPassword!,useSsl:config.pgUseSsl)..useConnection(conn);
    return (conn,sink);
  } catch(_) { await conn.close(); rethrow; }
}

Future<List<OutboxRecord>> queued(UploadStatsDB db) async {
  final raw=await db.getDatabase('station');
  final rows=await raw.query('sync_outbox',where:"entity IN ('capture_folder_rework','rework_logs')",
    orderBy:"CASE entity WHEN 'capture_folder_rework' THEN 0 ELSE 1 END,id");
  return rows.map((r)=>OutboxRecord(id:r['id'] as int,entity:r['entity'] as String,
    entityKey:r['entity_key'] as String,op:r['op'] as String,attempts:r['attempts'] as int,
    payload:Map<String,dynamic>.from(jsonDecode(r['payload'] as String)))).toList();
}


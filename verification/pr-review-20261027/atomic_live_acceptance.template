  test('livePG: unavailable database preserves the exact durable queue for later transport', () async {
    final h=await fixture(); identify(h);
    h._reworkStaged.clear(); h._reworkMetadataFixed.addAll(['1.jpg','2.jpg']);
    await h._onSubmitReworkPressed();
    final batch=await queued(db);
    final socket=await ServerSocket.bind(InternetAddress.loopbackIPv4,0);
    final unusedPort=socket.port; await socket.close();
    final offline=PgSyncSink(host:'127.0.0.1',port:unusedPort,database:'unused',user:'unused',password:'unused',useSsl:false);
    await expectLater(offline.apply(batch),throwsA(isA<SyncConnectException>()));
    expect(jsonEncode((await queued(db)).map((r)=>r.payload).toList()),jsonEncode(batch.map((r)=>r.payload).toList()));
    final (conn,sink)=await realPg();
    try {
      await sink.apply(await queued(db));
      expect((await conn.execute("SELECT count(*) FROM rework_logs WHERE rework_status='CLOSED'")).single[0],2);
      print('LIVE_PG disconnect/reconnect: queue unchanged while unavailable, later batch applied');
    } finally { await conn.close(); }
  });

  Future<void> seedSnapshot(Connection conn) async {
    await conn.execute('CREATE TEMP TABLE devices AS SELECT * FROM public.devices WITH NO DATA');
    await conn.execute("INSERT INTO devices(id,device_id) VALUES(1,'station')");
    await conn.execute("UPDATE capture_boxes SET device_id=1,user_id=1,is_deleted=FALSE,status='OPEN'");
    await conn.execute("UPDATE capture_folders SET is_deleted=FALSE,title='Acceptance',volume='V'||id,folder_name='V'||id");
    await conn.execute("UPDATE capture_images SET image_name='station_IMG_20260701_12000'||id||'_001.jpg',file_format='jpg'");
  }

  test('livePG: missing local DB recovers real PG snapshot and flags unknown bindings', () async {
    final (conn,sink)=await realPg();
    try {
      await seedSnapshot(conn);
      final path=await db.getDeviceDbFilePath('station');
      expect(await File(path).exists(),isFalse);
      final counts=await db.rebuildFromCaptureSnapshot(deviceId:'station',requireNonEmpty:true,
        pull:({required onBoxes,required onFolders,required onImages})=>sink.pullCaptureSnapshot('station',onBoxes:onBoxes,onFolders:onFolders,onImages:onImages));
      expect([counts.boxes,counts.folders,counts.images],[1,2,2]);
      final raw=await db.getDatabase('station');
      expect(await raw.query('color_integrity'),isNotEmpty);
      final check=await db.checkFolderColorCalibration('station',1);
      expect(check.hasIssues,isTrue);
      expect(check.issueSummary,contains('missing'));
      expect(await db.bindHistoricalIfUnbound('station',1),1);
      expect(await db.clearColorIntegrityIfOpenPagesBound('station'),isFalse);
      expect(await db.bindHistoricalIfUnbound('station',2),1);
      expect(await db.clearColorIntegrityIfOpenPagesBound('station'),isTrue);
      expect(await raw.query('color_integrity'),isEmpty);
      print('LIVE_PG recovery missing DB: 1/2/2 snapshot restored, unknown binding held, explicit per-folder acceptance clears last flag');
    } finally { await conn.close(); }
  });


  Future<_SubmitHarness> fixture({bool sameFolder = false}) async {
    final auth = AuthController(); auth.deviceId.value = 'station';
    final session = BoxSessionController(auth);
    final boxId = await db.insertCaptureBox(deviceId: 'station', boxDetails: 'BOX', projectKey: 'pk', projectId: 'PRJ');
    session.activeBox.value = (await db.getCaptureBoxById(deviceId: 'station', boxId: boxId))!;
    final items = <ReworkItem>[];
    final targets = <String, File>{};
    for (var n = 1; n <= 2; n++) {
      final folderId = sameFolder && n == 2 ? session.foldersOfActiveBox.first.id : await db.insertCaptureFolder(deviceId: 'station', folder: CaptureFolder(boxId: boxId, title: 'T', volume: 'V$n'), isComplete: true);
      final folder = (await db.getCaptureFolders(deviceId: 'station', boxId: boxId)).firstWhere((f) => f.id == folderId);
      if (!session.foldersOfActiveBox.any((f) => f.id == folder.id)) session.foldersOfActiveBox.add(folder);
      final name = '$n.jpg';
      await db.assignImageToFolder(deviceId: 'station', boxId: boxId, folderId: folderId, deviceFilename: name);
      final dir = await Directory(p.join(root.path, 'input${sameFolder ? 1 : n}')).create();
      final marker = File(p.join(dir.path, kProcessingMarkerName));
      if (!await marker.exists()) await marker.writeAsString('{}');
      final target = await File(p.join(dir.path, name)).writeAsBytes([0]);
      targets[name] = target;
      final shot = await File(p.join(root.path, 'shot$n.jpg')).writeAsBytes([n]);
      session.reworkStaged[name] = await ColorReworkStore.stage('station', target.path, shot, ColorBinding.none('disabled'));
      items.add(ReworkItem(reworkId:n, projectKey:'pk', projectId:'PRJ', boxName:'BOX', folderSeq:folder.folderSeq,
        folderName:'V$n', folderPath:dir.path, qcStatus:'REWORK', imageName:name, reason:'blur', reworkType:'Recapture'));
    }
    return _SubmitHarness(session, auth, items, targets);
  }

  Future<Map<String,dynamic>?> closure(String key) async {
    final raw = await db.getDatabase('station');
    final rows = await raw.query('sync_outbox',where:"entity = 'rework_logs' AND entity_key = ?",whereArgs:[key]);
    return rows.isEmpty ? null : Map<String,dynamic>.from(jsonDecode(rows.single['payload'] as String));
  }
  test('fixed: partial retry skips completed page and can finish remaining page', () async {
    final h = await fixture();
    await File('${h._reworkStaged['2.jpg']!.path}.color.json').writeAsString('{}');
    await h._onSubmitReworkPressed();
    expect(h._boxSession.reworkClosed, contains('1.jpg'));
    expect(h._reworkItems.map((i)=>i.imageName), ['2.jpg']);
    expect(reworkOpenItemCount(h._reworkItems,staged:h._reworkStaged.keys.toSet(),metadataFixed:h._reworkMetadataFixed,closed:h._boxSession.reworkClosed),0);
    h._reworkStaged['2.jpg'] = await ColorReworkStore.stage('station',h.targets['2.jpg']!.path,
      File(p.join(root.path,'shot2.jpg')),ColorBinding.none('disabled'));
    await h._onSubmitReworkPressed();
    expect(h.writes,['1.jpg','2.jpg']);
    expect(await db.pendingReworkClosureKeys('station'),containsAll(['pk|BOX|1|1.jpg','pk|BOX|2|2.jpg']));
  });
  testWidgets('fixed: Undo disables Submit and submit entry rejects the call', (tester) async {
    final h = (await tester.runAsync(() => fixture()))!;
    h._reworkUndoing.add('1.jpg');

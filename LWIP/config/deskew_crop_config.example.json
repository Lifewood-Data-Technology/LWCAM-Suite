{
  "input_root": "C:/LWCamDev/1.Images",
  "output_root": "C:/LWCamDev/2.Batches",
  "work_root": "runtime/deskew_crop/work",
  "state_file": "runtime/deskew_crop/state.json",
  "log_file": "runtime/logs/deskew_crop.log",
  "workers": 0,
  "poll_interval_seconds": 5,
  "stable_seconds": 60,
  "minimum_file_age_seconds": 30,
  "presence_check_interval_seconds": 300,
  "checksum_check_interval_seconds": 86400,
  "rework_settle_seconds": 30,
  "completion_marker": "",
  "recursive": true,
  "folder_depth": 1,
  "extensions": [".jpg", ".jpeg", ".png", ".tif", ".tiff", ".bmp", ".jxl"],
  "crop_padding": 200,
  "deskew_min_degrees": 0.5,
  "mat_fill": true,
  "jpeg_quality": 100,
  "thumbnail_width": 0,
  "thumbnail_quality": 85,
  "thumbnail_dirname": "thumbs",

  "cloud_report": false,
  "db_host": "localhost",
  "db_port": 5432,
  "db_name": "lwcam",
  "db_user": "lwcam_user",
  "db_password": "<your database password>",
  "db_use_ssl": false,

  "ui_bind": "127.0.0.1",
  "ui_port": 8090,
  "tls_cert_file": "",
  "tls_key_file": ""
}
